# ==============================================================================
# SmartKas — Root Apache .htaccess (cPanel / Shared Hosting)
# Repository Path: /home/pesonaas/repositories/SmartKas
# ==============================================================================

# ------------------------------------------------------------------------------
# [PENTING] PENYESUAIAN VERSI PHP 8.4 DI CPANEL
# Aplikasi SmartKas (Laravel 13 + Symfony 8.4 + Spatie Activitylog) WAJIB
# berjalan pada PHP >= 8.4.1 (tidak dapat berjalan di PHP 8.1).
#
# Jika server cPanel Anda SUDAH memiliki PHP 8.4 tetapi MultiPHP default masih
# 8.1, HAPUS TANDA '#' pada SALAH SATU blok handler sesuai jenis server Anda:
#   - Cek di cPanel Terminal: ls /opt/cpanel/ea-php84 /opt/alt/php84
#   - JANGAN aktifkan handler yang tidak terinstal karena file .php bisa terunduh mentah.
# ------------------------------------------------------------------------------

# Opsi 1: cPanel EasyApache 4 (Apache + ea-php84)
# <IfModule mime_module>
#     AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
# </IfModule>

# Opsi 2: CloudLinux PHP Selector + LiteSpeed (alt-php84)
# <FilesMatch "\.(php4|php5|php3|php2|php|phtml)$">
#     SetHandler application/x-httpd-alt-php84___lsphp
# </FilesMatch>

# Opsi 3: CloudLinux Alt-PHP Apache (alt-php84)
# <IfModule mime_module>
#     AddHandler application/x-httpd-alt-php84 .php .php8 .phtml
# </IfModule>

# ------------------------------------------------------------------------------
# Keamanan: Blokir akses langsung ke file sensitif & direktori internal Laravel
# ------------------------------------------------------------------------------
Options -Indexes

<FilesMatch "^\.(env|git|cpanel|htaccess|htpasswd)|^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|vite\.config\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses HTTP ke folder internal Laravel
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L]

    # Teruskan Header Authorization & X-XSRF-Token ke folder public/
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Arahkan semua request web ke public/ jika DocumentRoot masih menunjuk root repo
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
